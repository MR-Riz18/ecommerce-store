# ShopNova backend environment — copy to `.env` and fill in real values.
# Never commit a real `.env` file.

# Port the API listens on
PORT=5000

# MongoDB connection string (local MongoDB, Docker, or Atlas)
MONGO_URI=mongodb://localhost:27017/ecommerce

# Secret used to sign JWTs — set a long random string in production
JWT_SECRET=change-this-to-a-long-random-secret

# JWT lifetime (e.g. 7d, 24h)
JWT_EXPIRE=7d

# Frontend origin allowed by CORS
CLIENT_URL=http://localhost:5173

# development | production
NODE_ENV=development
